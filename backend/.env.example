NODE_ENV=development
PORT=4000
CLIENT_URL=http://localhost:5173
DATABASE_URL=
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10
DATABASE_CONNECT_TIMEOUT_SECONDS=10
DATABASE_SSL=required
# Base64-encoded provider CA certificate. Never commit the real value.
DATABASE_SSL_CA_BASE64=
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRES_IN=12h
OTP_EXPIRES_MINUTES=10
REQUEST_TIMEOUT_SECONDS=120
# Coturn/TURN REST credentials. Keep TURN_SHARED_SECRET only on the backend host.
TURN_URL=
TURN_SHARED_SECRET=
TURN_TTL_SECONDS=3600
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Bodhi-Mitra <support@example.edu>
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@example.edu
CAMPUS_HOTLINE_LABEL=GBU Counselling Centre
CAMPUS_HOTLINE_NUMBER=+91 9650257255
NATIONAL_HOTLINE_LABEL=Tele-MANAS
NATIONAL_HOTLINE_NUMBER=14416
ADMIN_EMAIL=admin@example.edu
ADMIN_PASSWORD=replace-this-before-seeding
